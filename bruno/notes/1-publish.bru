meta {
    name: Publish note
    type: http
    seq: 1
}

post {
    url: {{urlA}}/api/notes
    body: json
    auth: bearer
}

auth:bearer {
    token: {{token}}
}

body:json {
    {
        "content": "Hola desde Bruno",
        "visibility": "public"
    }
}

script:post-response {
    bru.setVar("noteId", res.body.id)
}

docs {
    Publica una nota (1-500 caracteres) como el usuario autenticado.
    visibility: public (todos), unlisted (todos, fuera de local/federada) o followers (sólo seguidores).
}