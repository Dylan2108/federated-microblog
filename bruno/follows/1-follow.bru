meta {
    name: Follow other user
    type: http
    seq: 1
}

post {
    url: {{urlA}}/api/users/{{otherUser}}/follow
    body: none
    auth: bearer
}

auth:bearer {
    token: {{token}}
}

docs {
    El usuario autenticado sigue a otherUser. Devuelve {"state": "accepted"} o, si otherUser tiene
    la cuenta privada, {"state": "pending"} hasta que la acepte. Es idempotente.
}